---
// Dekorative Animation für die Projekt-Übersicht: ein Steinturm in den Farben der Seite, ein Stein pro Projekt.
// Die Steine kommen aus der Projekt-Sammlung, ein neues Projekt bekommt also automatisch seinen Stein. Sie liegen
// in der Reihenfolge der Karten: die letzte Karte unten, die erste oben. Das Skript misst die Karten: Jeder Stein
// liegt auf Höhe seiner Karte und ist so hoch wie sie, die Steine berühren sich also und bilden weiter einen Turm.
// Beim Laden legt sich der Turm einmal Stein für Stein auf; wer über eine Karte fährt oder sie fokussiert, hebt
// ihren Stein hervor. Die Struktur ist festes SVG mit fertigem, kompaktem Turm (sichtbar ohne JavaScript und bei
// "Bewegung reduzieren").
interface Props { ids: string[] }
const { ids } = Astro.props;
const colors = ['ink', 'moss', 'slate', 'sage', 'grey'];
const shift = [0, -6, 5, -4, 6, -3, 4, -5, 3, -2, 2, -1];
const n = ids.length;
const ry = 21;
const pitch = ry * 2 + 4;
const height = Math.max(240, n * pitch + 24);
const base = height - 6;
const stones = [...ids].reverse().map((id, i) => ({
  id,
  w: n === 1 ? 96 : 108 - (i * 60) / Math.max(n - 1, 1),
  cx: 70 + shift[i % shift.length],
  cy: base - ry - i * pitch,
  color: colors[i % colors.length],
}));
---
<svg class="margin-art pebbles tower" viewBox={`0 0 140 ${height}`} preserveAspectRatio="xMidYMin meet" aria-hidden="true" focusable="false">
  {stones.map((s) => <ellipse class={`pebble pebble--${s.color}`} data-project={s.id} cx={s.cx} cy={s.cy} rx={s.w / 2} ry={ry} />)}
</svg>

<script>
  const svg = document.querySelector<SVGSVGElement>('.tower');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (svg) {
    const stones = [...svg.querySelectorAll<SVGEllipseElement>('.pebble')];
    const cardOf = (s: SVGEllipseElement) => document.querySelector<HTMLElement>(`.card[data-project="${s.dataset.project}"]`);

    // Jeder Stein mittig neben seiner Karte und so hoch wie sie (plus der halbe Abstand zur nächsten Karte).
    const layout = () => {
      const w = svg.getBoundingClientRect().width;
      if (w === 0) return;
      const scale = w / 140;
      const top = svg.getBoundingClientRect().top;
      const gap = parseFloat(getComputedStyle(document.querySelector('.grid')!).rowGap) || 0;
      let end = 0;
      for (const s of stones) {
        const r = cardOf(s)?.getBoundingClientRect();
        if (!r) continue;
        s.setAttribute('cy', String((r.top + r.height / 2 - top) / scale));
        s.setAttribute('ry', String(Math.max(4, (r.height / 2 + gap / 2) / scale - 1)));
        end = Math.max(end, (r.bottom - top) / scale);
      }
      if (end) svg.setAttribute('viewBox', `0 0 140 ${end + 6}`);
    };
    layout();
    addEventListener('load', layout);
    addEventListener('resize', layout);
    new ResizeObserver(layout).observe(document.body);

    for (const stone of stones) {
      const card = cardOf(stone);
      if (!card) continue;
      const on = (v: boolean) => () => stone.classList.toggle('on', v);
      card.addEventListener('mouseenter', on(true));
      card.addEventListener('mouseleave', on(false));
      card.addEventListener('focusin', on(true));
      card.addEventListener('focusout', on(false));
    }
    // Einmal beim Laden: die Steine legen sich von unten nach oben auf.
    if (!reduce.matches) {
      svg.classList.add('live');
      stones.forEach((s) => s.classList.add('out'));
      stones.forEach((s, i) => setTimeout(() => s.classList.remove('out'), 400 + i * 260));
    }
  }
</script>
