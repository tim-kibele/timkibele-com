---
// Dekorative Animation für die Interessen-Übersicht: Neben jedem Eintrag der Liste steht das Motiv seiner
// Unterseite, in einem Kästchen wie die Knoten der KI-Animation: ein Controller (Gaming), die F-Taste mit ihrem
// Taststeg (Tastaturen), Equalizer-Balken (Musik), ein Agent (KI), ein Herz (Freundin), zwei Eltern und zwei Kinder
// (Familie). Seiten ohne eigenes Motiv bekommen keins. Wer über
// einen Eintrag fährt oder ihn fokussiert, hebt sein Motiv hervor. Das Skript richtet die Motive an den Zeilen
// aus; ohne JavaScript stehen sie in festem Abstand.
interface Props { ids: string[] }
const { ids } = Astro.props;
const icons: Record<string, string> = {
  gaming: '<path d="M-6 -6 H6 C10 -6 12 -4 13 0 L14.5 6 C15.2 9 12 10.5 10 8.2 L7.5 5 H-7.5 L-10 8.2 C-12 10.5 -15.2 9 -14.5 6 L-13 0 C-12 -4 -10 -6 -6 -6 Z M-8 -2.5 V2.5 M-10.5 0 H-5.5"/><circle class="dot" cx="6.5" cy="-1.5" r="1.3"/><circle class="dot" cx="9.5" cy="1.5" r="1.3"/>',
  'mechanische-tastaturen': '<rect x="-11" y="-11" width="22" height="22" rx="3.5"/><rect x="-7" y="-9" width="14" height="13" rx="2.5"/><path d="M-2 -6 V0 M-2 -6 H2.5 M-2 -3.2 H1.5 M-2.2 2 H2.2"/>',
  musik: '<rect class="bar" x="-10" y="-1" width="3.4" height="10" rx="1.2"/><rect class="bar" x="-4.6" y="-9" width="3.4" height="18" rx="1.2"/><rect class="bar" x="0.8" y="-4" width="3.4" height="13" rx="1.2"/><rect class="bar" x="6.2" y="-6" width="3.4" height="15" rx="1.2"/>',
  freundin: '<path class="heart" d="M0 9 C-14 -1 -7 -12 0 -5 C7 -12 14 -1 0 9 Z"/>',
  familie: '<circle cx="-10.5" cy="-6" r="2.2"/><path d="M-13 9 V3 C-13 0.2 -12 -1.6 -10.5 -1.6 C-9 -1.6 -8 0.2 -8 3 V9"/><circle cx="-3.5" cy="-6" r="2.2"/><path d="M-6 9 V3 C-6 0.2 -5 -1.6 -3.5 -1.6 C-2 -1.6 -1 0.2 -1 3 V9"/><circle cx="4" cy="0" r="1.7"/><path d="M2.2 9 V5.6 C2.2 4.3 3 3.3 4 3.3 C5 3.3 5.8 4.3 5.8 5.6 V9"/><circle cx="10.5" cy="0" r="1.7"/><path d="M8.7 9 V5.6 C8.7 4.3 9.5 3.3 10.5 3.3 C11.5 3.3 12.3 4.3 12.3 5.6 V9"/>',
  ki: '<g transform="scale(1.6)"><path d="M-4 -4 H4 A2 2 0 0 1 6 -2 V3 A2 2 0 0 1 4 5 H-4 A2 2 0 0 1 -6 3 V-2 A2 2 0 0 1 -4 -4 Z M0 -4 V-6.5 M-8 -0.5 V2.5 M8 -0.5 V2.5 M-2.5 3 H2.5"/><circle class="dot" cx="0" cy="-7" r="1"/><circle class="dot" cx="-2.3" cy="0.5" r="1"/><circle class="dot" cx="2.3" cy="0.5" r="1"/></g>',
};
const marks = ids.map((id, i) => ({ id, y: 40 + i * 48, icon: icons[id] })).filter((m) => m.icon);
const end = 40 + (ids.length - 1) * 48;
---
<svg class="margin-art marks" viewBox={`0 0 140 ${end + 40}`} preserveAspectRatio="xMidYMin meet" aria-hidden="true" focusable="false">
  {marks.map((m) => (
    <g class="mark" data-topic={m.id} transform={`translate(70 ${m.y})`}>
      <g class="mark-body">
        <rect class="frame" x="-16" y="-16" width="32" height="32" rx="7" />
        <g class="icon" transform="scale(0.78)" set:html={m.icon} />
      </g>
    </g>
  ))}
</svg>

<script>
  const svg = document.querySelector<SVGSVGElement>('.marks');
  if (svg) {
    const marks = [...svg.querySelectorAll<SVGGElement>('.mark')];
    const rowOf = (m: SVGGElement) => document.querySelector<HTMLElement>(`.topics [data-topic="${m.dataset.topic}"]`);

    // Jedes Motiv steht mittig neben seinem Eintrag.
    const layout = () => {
      const w = svg.getBoundingClientRect().width;
      if (w === 0) return;
      const scale = w / 140;
      const top = svg.getBoundingClientRect().top;
      let end = 0;
      for (const m of marks) {
        const r = rowOf(m)?.getBoundingClientRect();
        if (!r) continue;
        const y = (r.top + r.height / 2 - top) / scale;
        m.setAttribute('transform', `translate(70 ${y})`);
        end = Math.max(end, y);
      }
      if (end) svg.setAttribute('viewBox', `0 0 140 ${end + 40}`);
    };

    for (const m of marks) {
      const row = rowOf(m);
      if (!row) continue;
      const on = (v: boolean) => () => m.classList.toggle('on', v);
      row.addEventListener('mouseenter', on(true));
      row.addEventListener('mouseleave', on(false));
      row.addEventListener('focusin', on(true));
      row.addEventListener('focusout', on(false));
    }

    layout();
    addEventListener('load', layout);
    addEventListener('resize', layout);
    new ResizeObserver(layout).observe(document.body);
  }
</script>
