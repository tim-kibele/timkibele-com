---
// Dekorative Spiel-Oberfläche für die Gaming-Seite: drei Leben und eine Levelanzeige oben, darunter
// eine senkrechte Erfahrungsleiste über die ganze Seite. Jeder Abschnitt des Textes ist eine Aufgabe auf
// der Leiste (das Skript misst die Überschriften). Beim Scrollen füllt sich die Leiste, erreichte
// Abschnitte werden abgehakt, und das Level steigt. Die Leben schwanken gelegentlich.
// Zweites Easter Egg: Wer ganz ans Seitenende scrollt, deckt eine versteckte fünfte Aufgabe auf. Die Leiste
// läuft weiter, und darunter erscheint die Geheimpartie gegen Timgnus Kibelsen (Stockfish voll aufgedreht).
// Easter Egg: Dreimal auf die Herzen klicken, und es erscheint ein "YOU DIED"-Bildschirm (angelehnt an
// Dark Souls), der die Seite sperrt, bis sie neu geladen wird.
// Die Struktur ist festes SVG und zeigt den fertigen Zustand (sichtbar ohne JavaScript und bei
// "Bewegung reduzieren"): alle Aufgaben erledigt, Leiste voll.
const hearts = [44, 70, 96];
const heart = 'M0 5 C-8 -1 -4 -7 0 -3 C4 -7 8 -1 0 5 Z';
const trackTop = 96;
const staticQuests = [170, 250, 330, 410]; // Lage ohne JavaScript
const lens = [70, 54, 62, 58];
const last = staticQuests[staticQuests.length - 1];
---
<svg class="margin-art gamepad" viewBox={`0 0 140 ${last + 40}`} preserveAspectRatio="xMidYMin meet" aria-hidden="true" focusable="false">
  <rect class="hearts-hit" x="20" y="2" width="100" height="48" />
  {hearts.map((x) => (
    <path class="heart" transform={`translate(${x} 26) scale(1.8)`} d={heart} />
  ))}

  <text class="level" x="20" y="76">Lv {staticQuests.length + 1}</text>

  <rect class="xp-track" x="27.5" y={trackTop} width="3" height={last - trackTop} rx="1.5" data-top={trackTop} />
  <rect class="xp-fill" x="27.5" y={trackTop} width="3" height={last - trackTop} rx="1.5" />

  <g class="quest boss-quest" transform={`translate(0 ${last + 80})`}>
    <rect class="box" x="22" y="-7" width="14" height="14" rx="3" />
    <path class="tick" d="M25 0 L28.5 3.5 L34 -3.5" />
    <rect class="line" x="46" y="-1.5" width="50" height="3" rx="1.5" />
  </g>
  {staticQuests.map((y, i) => (
    <g class="quest done" transform={`translate(0 ${y})`}>
      <rect class="box" x="22" y="-7" width="14" height="14" rx="3" />
      <path class="tick" d="M25 0 L28.5 3.5 L34 -3.5" />
      <rect class="line" x="46" y="-1.5" width={lens[i]} height="3" rx="1.5" />
    </g>
  ))}
</svg>

<script>
  import { unlock } from '../../scripts/achievements';

  const svg = document.querySelector<SVGSVGElement>('.gamepad');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (svg) {
    const hearts = [...svg.querySelectorAll<SVGElement>('.heart')];
    const quests = [...svg.querySelectorAll<SVGGElement>('.quest:not(.boss-quest)')];
    const bossQuest = svg.querySelector<SVGGElement>('.boss-quest')!;
    const boss = document.querySelector<HTMLElement>('.boss');
    const gap = document.querySelector<HTMLElement>('.boss-gap'); // leerer Weg unter der Schachpartie: etwa zwei Bildschirmhöhen
    let revealed = false;
    const levelEl = svg.querySelector('.level')!;
    const track = svg.querySelector<SVGRectElement>('.xp-track')!;
    const fill = svg.querySelector<SVGRectElement>('.xp-fill')!;
    const top = Number(track.dataset.top);
    const hit = svg.querySelector<SVGElement>('.hearts-hit')!;
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    let bossY = 0;
    let gapEnd = 0;
    let ys = quests.map(() => 0); // Mitte jeder Aufgabe im Bild, in Einheiten
    let live = false;
    let lives = 3;
    let timer = 0;
    let clicks = 0;

    // Jede Aufgabe steht auf Höhe der Überschrift ihres Abschnitts.
    const layout = () => {
      const w = svg.getBoundingClientRect().width;
      if (w === 0) return;
      if (gap) gap.style.height = `${innerHeight * 2}px`;
      const scale = w / 140;
      const svgTop = svg.getBoundingClientRect().top;
      const heads = [...document.querySelectorAll('.topic > h2')];
      ys = quests.map((_, i) => {
        const h = heads[i];
        if (!h) return ys[i] || top + 40 * (i + 1);
        const r = h.getBoundingClientRect();
        return (r.top + r.height / 2 - svgTop) / scale;
      });
      quests.forEach((q, i) => q.setAttribute('transform', `translate(0 ${ys[i]})`));
      if (revealed && boss) {
        const r = boss.querySelector('.boss-title')!.getBoundingClientRect();
        bossY = (r.top + r.height / 2 - svgTop) / scale;
        bossQuest.setAttribute('transform', `translate(0 ${bossY})`);
      }
      gapEnd = gap ? (gap.getBoundingClientRect().bottom - svgTop) / scale : ys[ys.length - 1];
      const end = revealed ? bossY : ys[ys.length - 1];
      for (const el of [track, fill]) el.setAttribute('height', String(Math.max(0, end - top)));
      svg.setAttribute('viewBox', `0 0 140 ${(revealed ? bossY : Math.max(gapEnd, end)) + 40}`);
      update();
    };

    // Die Leiste füllt sich bis zur Bildschirmmitte, erreichte Aufgaben werden abgehakt.
    const update = () => {
      if (!live) return;
      const w = svg.getBoundingClientRect().width;
      if (w === 0) return;
      const scale = w / 140;
      const p = (innerHeight * 0.55 - svg.getBoundingClientRect().top) / scale;
      // Vor dem Aufdecken wächst die Leiste hinter der letzten Aufgabe nur so weit, wie man gescrollt hat.
      const lastY = ys[ys.length - 1];
      const end = revealed ? bossY : Math.max(lastY, Math.min(p, gapEnd));
      for (const el of [track, fill]) el.setAttribute('height', String(Math.max(0, end - top)));
      fill.style.transform = `scaleY(${Math.min(1, Math.max(0, (p - top) / (end - top)))})`;
      let done = 0;
      quests.forEach((q, i) => {
        const on = p >= ys[i];
        q.classList.toggle('done', on);
        if (on) done++;
      });
      if (revealed) {
        const on = p >= bossY;
        bossQuest.classList.toggle('done', on);
        if (on) done++;
      }
      levelEl.textContent = `Lv ${done + 1}`;
    };

    // Zweites Easter Egg: ganz unten wird die versteckte Aufgabe samt Partie aufgedeckt.
    const reveal = () => {
      if (revealed || !boss) return;
      revealed = true;
      unlock('final-boss');
      const still = reduce.matches;
      document.documentElement.style.overflowAnchor = 'none';
      boss.hidden = false;
      bossQuest.classList.add('show');
      if (!still) {
        boss.style.opacity = '0';
        requestAnimationFrame(() => {
          boss.style.transition = 'opacity 900ms ease-out';
          boss.style.opacity = '1';
        });
      }
      layout();
    };

    let queued = false;
    const onScroll = () => {
      if (!revealed && scrollY + innerHeight >= document.documentElement.scrollHeight - 80) reveal();
      if (queued) return;
      queued = true;
      requestAnimationFrame(() => {
        queued = false;
        update();
      });
    };

    const hurt = () => {
      if (!live || clicks > 0) return;
      if (svg.getBoundingClientRect().width > 0) {
        lives = lives > 1 ? lives - 1 : 3;
        hearts.forEach((h, i) => h.classList.toggle('lost', i >= lives));
      }
      timer = window.setTimeout(hurt, rand(2500, 6000));
    };

    const start = () => {
      live = true;
      document.documentElement.classList.add('js');
      layout();
      timer = window.setTimeout(hurt, 2500);
    };
    const stop = () => {
      live = false;
      clearTimeout(timer);
      document.documentElement.classList.remove('js');
      fill.style.transform = '';
      quests.forEach((q) => q.classList.add('done'));
      levelEl.textContent = `Lv ${quests.length + 1}`;
      hearts.forEach((h) => h.classList.remove('lost'));
    };

    // Easter Egg: jeder Klick auf die Herzen kostet ein Leben, beim dritten ist es vorbei.
    const died = () => {
      const noMotion = reduce.matches;
      const hint = document.documentElement.lang === 'de' ? 'Lade die Seite neu, um weiterzumachen.' : 'Reload the page to continue.';
      const screen = document.createElement('div');
      screen.className = 'died';
      screen.setAttribute('role', 'alert');
      screen.tabIndex = -1;
      const text = document.createElement('p');
      text.className = 'died-text';
      text.textContent = 'YOU DIED';
      const note = document.createElement('p');
      note.className = 'died-hint';
      note.textContent = hint;
      screen.append(text, note);
      if (noMotion) screen.classList.add('still');
      document.querySelectorAll('header.site, main, footer').forEach((el) => el.setAttribute('inert', ''));
      document.body.style.overflow = 'hidden';
      document.body.append(screen);
      unlock('you-died');
      screen.focus();
      requestAnimationFrame(() => screen.classList.add('on'));
      setTimeout(() => note.classList.add('on'), noMotion ? 0 : 5000);
    };
    hit.addEventListener('click', () => {
      if (clicks >= 3) return;
      clicks++;
      lives = 3 - clicks;
      hearts.forEach((h, i) => h.classList.toggle('lost', i >= lives));
      if (clicks === 3) setTimeout(died, 700);
    });

    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', layout);
    addEventListener('load', layout);
    new ResizeObserver(layout).observe(document.body);
    if (!reduce.matches) start();
    reduce.addEventListener('change', () => (reduce.matches ? stop() : start()));
  }
</script>
