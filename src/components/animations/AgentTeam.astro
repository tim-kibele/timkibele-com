---
// Dekorative Animation für die KI-Seite: Ein Mensch gibt einen Auftrag an einen Koordinator, der ihn auf drei
// KI-Agenten verteilt. Ein Prüfer nimmt die Ergebnisse ab und schickt gelegentlich eines zurück.
// Die Struktur ist festes SVG (sichtbar ohne JavaScript und bei "Bewegung reduzieren"),
// das Skript lässt nur die Signale laufen.
const S = 20; // halbe Kantenlänge eines Knotens
const nodes = [
  { id: 'A', x: 70, y: 60, icon: 'person' },
  { id: 'B', x: 70, y: 210, icon: 'split' },
  { id: 'C1', x: 22, y: 360, icon: 'robot' },
  { id: 'C2', x: 70, y: 360, icon: 'robot' },
  { id: 'C3', x: 118, y: 360, icon: 'robot' },
  { id: 'D', x: 70, y: 510, icon: 'review' },
  { id: 'E', x: 70, y: 660, icon: 'done' },
];
const links = ['A-B', 'B-C1', 'B-C2', 'B-C3', 'C1-D', 'C2-D', 'C3-D', 'D-E'];
const by = Object.fromEntries(nodes.map((n) => [n.id, n]));
const edges = links.map((key) => {
  const [a, b] = key.split('-').map((id) => by[id]);
  const y1 = a.y + S, y2 = b.y - S, ym = (y1 + y2) / 2;
  return { key, d: `M${a.x} ${y1} C${a.x} ${ym} ${b.x} ${ym} ${b.x} ${y2}` };
});
const icons: Record<string, string> = {
  person: '<path d="M-7 -3 H7 M-4 -3 V-7.5 H4 V-3"/><circle cx="0" cy="1" r="2.2"/><path d="M-6 8 V7 C-6 5.4 -3 4.8 0 4.8 C3 4.8 6 5.4 6 7 V8 M-2 5 L0 7 L2 5"/>',
  split: '<circle cx="0" cy="-5" r="2"/><circle cx="-6" cy="5" r="2"/><circle cx="6" cy="5" r="2"/><path d="M0 -3 V0 M0 0 L-6 3 M0 0 L6 3"/>',
  robot: '<path d="M-4 -4 H4 A2 2 0 0 1 6 -2 V3 A2 2 0 0 1 4 5 H-4 A2 2 0 0 1 -6 3 V-2 A2 2 0 0 1 -4 -4 Z M0 -4 V-6.5 M-8 -0.5 V2.5 M8 -0.5 V2.5 M-2.5 3 H2.5"/><circle class="dot" cx="0" cy="-7" r="1"/><circle class="dot" cx="-2.3" cy="0.5" r="1"/><circle class="dot" cx="2.3" cy="0.5" r="1"/>',
  review: '<circle cx="-2" cy="-2" r="5"/><path d="M2 2 L7 7"/>',
  done: '<path d="M-7 0 L-2 5 L7 -6"/>',
};
---
<svg class="margin-art agents" viewBox="0 0 140 780" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <g>
    {edges.map((e) => <path class="edge" data-e={e.key} d={e.d} />)}
  </g>
  <g>
    {nodes.map((n) => (
      <g class="wf-node" data-n={n.id} transform={`translate(${n.x} ${n.y})`}>
        <rect x={-S} y={-S} width={S * 2} height={S * 2} rx="8" />
        <g class="wf-icon" transform="scale(1.2)" set:html={icons[n.icon]} />
      </g>
    ))}
  </g>
  <g class="pulses"></g>
</svg>

<script>
  const svg = document.querySelector<SVGSVGElement>('.agents');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (svg) {
    const nodeEl: Record<string, Element> = {};
    const edgeEl: Record<string, SVGPathElement> = {};
    svg.querySelectorAll('[data-n]').forEach((n) => (nodeEl[(n as SVGElement).dataset.n!] = n));
    svg.querySelectorAll<SVGPathElement>('[data-e]').forEach((e) => (edgeEl[e.dataset.e!] = e));
    const layer = svg.querySelector('.pulses')!;
    let alive = false;

    const wait = (ms: number) => new Promise<void>((res) => setTimeout(res, ms));
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const on = (el: Element, ms: number) => {
      el.classList.add('on');
      setTimeout(() => el.classList.remove('on'), ms);
    };

    // Ein Signal läuft entlang einer Kante, vorwärts oder rückwärts (ein Agent wird zurückgeschickt).
    const pulse = (key: string, back = false) =>
      new Promise<void>((res) => {
        const edge = edgeEl[key];
        const el = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        el.setAttribute('r', '3.6');
        el.setAttribute('class', back ? 'pulse back' : 'pulse');
        layer.appendChild(el);
        edge.classList.add('on');
        const len = edge.getTotalLength();
        const dur = Math.min(1000, Math.max(450, len / 0.18));
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          const p = edge.getPointAtLength((back ? 1 - t : t) * len);
          el.setAttribute('transform', `translate(${p.x} ${p.y})`);
          if (t < 1 && alive) requestAnimationFrame(step);
          else {
            el.remove();
            setTimeout(() => edge.classList.remove('on'), 400);
            res();
          }
        };
        requestAnimationFrame(step);
      });

    const play = async () => {
      alive = true;
      while (alive) {
        if (svg.getBoundingClientRect().width === 0) {
          await wait(1000);
          continue;
        }
        on(nodeEl.A, 900);
        await pulse('A-B');
        on(nodeEl.B, 900);
        await wait(250);

        // Die drei Agenten arbeiten gleichzeitig und melden sich nacheinander.
        await Promise.all(
          ['C1', 'C2', 'C3'].map(async (id, i) => {
            await wait(i * 160);
            await pulse(`B-${id}`);
            on(nodeEl[id], rand(900, 1700));
            await wait(rand(900, 1700));
            await pulse(`${id}-D`);
            on(nodeEl.D, 700);
          }),
        );

        // Der Prüfer nimmt ab. Manchmal geht ein Ergebnis zurück an den Agenten.
        await wait(500);
        if (Math.random() < 0.4) {
          const id = `C${1 + Math.floor(Math.random() * 3)}`;
          await pulse(`${id}-D`, true);
          on(nodeEl[id], 1300);
          await wait(1300);
          await pulse(`${id}-D`);
          on(nodeEl.D, 700);
          await wait(500);
        }
        await pulse('D-E');
        on(nodeEl.E, 1400);
        await wait(rand(1800, 2800));
      }
    };

    if (!reduce.matches) play();
    reduce.addEventListener('change', () => {
      if (reduce.matches) alive = false;
      else if (!alive) play();
    });
  }
</script>
