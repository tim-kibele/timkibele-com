---
// Dekorative Animation für die KI-Seite als Kreislauf: Ein Mensch gibt einen Auftrag an einen
// Koordinator, der ihn auf drei KI-Agenten verteilt. Das Ergebnis läuft zum Menschen zurück, der es
// prüft und gelegentlich eine Korrektur anstößt. Die Struktur ist festes SVG (sichtbar ohne
// JavaScript und bei "Bewegung reduzieren"), das Skript lässt nur die Signale laufen.
const nodes = [
  { id: 'A', x: 70, y: 60, s: 20, icon: 'person' },
  { id: 'B', x: 70, y: 250, s: 20, icon: 'split' },
  { id: 'C1', x: 34, y: 440, s: 16, icon: 'robot' },
  { id: 'C2', x: 70, y: 440, s: 16, icon: 'robot' },
  { id: 'C3', x: 106, y: 440, s: 16, icon: 'robot' },
  { id: 'D', x: 70, y: 630, s: 20, icon: 'done' },
];
const links = ['A-B', 'B-C1', 'B-C2', 'B-C3', 'C1-D', 'C2-D', 'C3-D'];
const by = Object.fromEntries(nodes.map((n) => [n.id, n]));
const edges = links.map((key) => {
  const [a, b] = key.split('-').map((id) => by[id]);
  const y1 = a.y + a.s, y2 = b.y - b.s, ym = (y1 + y2) / 2;
  return { key, d: `M${a.x} ${y1} C${a.x} ${ym} ${b.x} ${ym} ${b.x} ${y2}` };
});
// Rückweg vom Ergebnis zum Menschen, links an den Agenten vorbei. Er fehlt zunächst (Easter Egg): Wer ihn
// vom Ergebnis zum Menschen zieht, schließt den Kreislauf, und erst dann prüft der Mensch die Ergebnisse.
edges.push({ key: 'D-A', d: 'M50 630 H10 Q4 630 4 624 V66 Q4 60 10 60 H50' });
const icons: Record<string, string> = {
  person: '<circle cx="0" cy="-3" r="3.2"/><path d="M-7 8 V6 C-7 3.5 -3.5 2.8 0 2.8 C3.5 2.8 7 3.5 7 6 V8 M-2.2 3.2 L0 6.5 L2.2 3.2 M0 6.5 V8"/>',
  split: '<circle cx="0" cy="-5" r="2"/><circle cx="-6" cy="5" r="2"/><circle cx="6" cy="5" r="2"/><path d="M0 -3 V0 M0 0 L-6 3 M0 0 L6 3"/>',
  robot: '<path d="M-4 -4 H4 A2 2 0 0 1 6 -2 V3 A2 2 0 0 1 4 5 H-4 A2 2 0 0 1 -6 3 V-2 A2 2 0 0 1 -4 -4 Z M0 -4 V-6.5 M-8 -0.5 V2.5 M8 -0.5 V2.5 M-2.5 3 H2.5"/><circle class="dot" cx="0" cy="-7" r="1"/><circle class="dot" cx="-2.3" cy="0.5" r="1"/><circle class="dot" cx="2.3" cy="0.5" r="1"/>',
  done: '<path d="M-7 0 L-2 5 L7 -6"/>',
};
---
<svg class="margin-art agents" viewBox="0 0 140 700" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
  <g>
    {edges.map((e) => <path class={e.key === 'D-A' ? 'edge loop' : 'edge'} data-e={e.key} d={e.d} />)}
  </g>
  <g>
    {nodes.map((n) => (
      <g class="wf-node" data-n={n.id} transform={`translate(${n.x} ${n.y})`}>
        <rect x={-n.s} y={-n.s} width={n.s * 2} height={n.s * 2} rx="8" />
        <g class="wf-icon" transform="scale(1.2)" set:html={icons[n.icon]} />
      </g>
    ))}
  </g>
  <g class="pulses"></g>
</svg>

<script>
  import { unlock } from '../../scripts/achievements';

  const svg = document.querySelector<SVGSVGElement>('.agents');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (svg) {
    const nodeEl: Record<string, Element> = {};
    const edgeEl: Record<string, SVGPathElement> = {};
    svg.querySelectorAll('[data-n]').forEach((n) => (nodeEl[(n as SVGElement).dataset.n!] = n));
    svg.querySelectorAll<SVGPathElement>('[data-e]').forEach((e) => (edgeEl[e.dataset.e!] = e));
    const layer = svg.querySelector('.pulses')!;
    let alive = false;
    let linked = false; // der Rückweg zum Menschen ist erst nach dem Ziehen da

    const wait = (ms: number) => new Promise<void>((res) => setTimeout(res, ms));
    const rand = (a: number, b: number) => a + Math.random() * (b - a);
    const on = (el: Element, ms: number) => {
      el.classList.add('on');
      setTimeout(() => el.classList.remove('on'), ms);
    };

    // Ein Signal läuft entlang einer Kante von ihrem Anfang bis zu ihrem Ende.
    const pulse = (key: string) =>
      new Promise<void>((res) => {
        const edge = edgeEl[key];
        const el = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        el.setAttribute('r', '3.6');
        el.setAttribute('class', 'pulse');
        layer.appendChild(el);
        edge.classList.add('on');
        const len = edge.getTotalLength();
        const dur = Math.min(1400, Math.max(450, len / 0.18));
        const start = performance.now();
        const step = (now: number) => {
          const t = Math.min(1, (now - start) / dur);
          const p = edge.getPointAtLength(t * len);
          el.setAttribute('transform', `translate(${p.x} ${p.y})`);
          if (t < 1 && alive) requestAnimationFrame(step);
          else {
            el.remove();
            setTimeout(() => edge.classList.remove('on'), 400);
            res();
          }
        };
        requestAnimationFrame(step);
      });

    // Ein Agent arbeitet an der Aufgabe und liefert sein Ergebnis beim Ergebnisknoten ab.
    const work = async (id: string, delay = 0) => {
      await wait(delay);
      await pulse(`B-${id}`);
      on(nodeEl[id], rand(900, 1700));
      await wait(rand(900, 1700));
      await pulse(`${id}-D`);
      on(nodeEl.D, 700);
    };
    // Das Ergebnis geht zurück zum Menschen, der es prüft.
    const review = async () => {
      await wait(400);
      await pulse('D-A');
      on(nodeEl.A, 1400);
      await wait(1400);
    };

    const play = async () => {
      alive = true;
      while (alive) {
        if (svg.getBoundingClientRect().width === 0) {
          await wait(1000);
          continue;
        }
        on(nodeEl.A, 900);
        await pulse('A-B');
        on(nodeEl.B, 900);
        await wait(250);
        await Promise.all(['C1', 'C2', 'C3'].map((id, i) => work(id, i * 160)));
        if (linked) await review();
        else await wait(900);

        // Manchmal ist das Ergebnis nicht gut genug: Der Mensch schickt einen Agenten noch einmal los.
        if (linked && Math.random() < 0.4) {
          on(nodeEl.A, 900);
          await pulse('A-B');
          on(nodeEl.B, 900);
          await work(`C${1 + Math.floor(Math.random() * 3)}`);
          await review();
        }
        await wait(rand(1200, 2000));
      }
    };

    // Easter Egg: Das Ergebnis lässt sich per Ziehen mit dem Menschen verbinden (oder umgekehrt).
    const loop = edgeEl['D-A'];
    const ends: Record<string, { id: string; x: number; y: number }> = {
      D: { id: 'A', x: 50, y: 630 },
      A: { id: 'D', x: 50, y: 60 },
    };
    const toSvg = (x: number, y: number) => {
      const pt = svg.createSVGPoint();
      pt.x = x;
      pt.y = y;
      return pt.matrixTransform(svg.getScreenCTM()!.inverse());
    };
    for (const id of ['A', 'D']) {
      nodeEl[id].addEventListener('pointerdown', (down) => {
        if (linked) return;
        const e = down as PointerEvent;
        e.preventDefault();
        const from = ends[id];
        const target = nodeEl[from.id];
        const line = document.createElementNS('http://www.w3.org/2000/svg', 'path');
        line.setAttribute('class', 'drag-line');
        layer.appendChild(line);
        // Mensch und Ergebnis liegen weiter auseinander als ein Bildschirm hoch ist: Am oberen oder unteren
        // Rand scrollt die Seite mit, und die Linie folgt auch beim Scrollen.
        let cx = e.clientX;
        let cy = e.clientY;
        let dragging = true;
        const draw = () => {
          const p = toSvg(cx, cy);
          line.setAttribute('d', `M${from.x} ${from.y} L${p.x} ${p.y}`);
        };
        const edge = () => {
          if (!dragging) return;
          const zone = 90;
          if (cy < zone) scrollBy(0, -Math.ceil((zone - cy) / 6));
          else if (cy > innerHeight - zone) scrollBy(0, Math.ceil((cy - (innerHeight - zone)) / 6));
          requestAnimationFrame(edge);
        };
        draw();
        requestAnimationFrame(edge);
        const move = (ev: PointerEvent) => {
          cx = ev.clientX;
          cy = ev.clientY;
          draw();
        };
        const done = (ev: PointerEvent) => {
          dragging = false;
          removeEventListener('scroll', draw);
          removeEventListener('pointermove', move);
          removeEventListener('pointerup', done);
          removeEventListener('pointercancel', done);
          line.remove();
          const r = target.getBoundingClientRect();
          const pad = 14;
          const hit = ev.clientX > r.left - pad && ev.clientX < r.right + pad && ev.clientY > r.top - pad && ev.clientY < r.bottom + pad;
          if (ev.type !== 'pointerup' || !hit) return;
          linked = true;
          loop.classList.add('linked');
          svg.classList.add('linked');
          on(nodeEl.A, 1400);
          unlock('loop-closed');
        };
        addEventListener('scroll', draw, { passive: true });
        addEventListener('pointermove', move);
        addEventListener('pointerup', done);
        addEventListener('pointercancel', done);
      });
    }

    if (!reduce.matches) play();
    reduce.addEventListener('change', () => {
      if (reduce.matches) alive = false;
      else if (!alive) play();
    });
  }
</script>
