---
// Dekorative Stackscan-Animation am rechten Rand: Eine fiktive Website (.example ist für Beispiele
// reserviert) wird eingetippt, vier Signale werden nacheinander geprüft, dann erscheint die erkannte
// Technik und wandert in die Ergebnisliste. Der Endzustand ist festes SVG (sichtbar ohne JavaScript und
// bei "Bewegung reduzieren"), das Skript spielt die Prüfungen immer wieder neu ab.
const signals = ['Header', 'Cookies', 'HTML', 'DNS'];
const hits = [true, false, true, false];
const current = { domain: 'nordlicht.example', tech: 'TYPO3' };
const history = [
  { domain: 'alpha.example', tech: 'WordPress' },
  { domain: 'kaffeehaus.example', tech: 'kein CMS' },
  { domain: 'werkstatt.example', tech: 'Contao' },
  { domain: 'atelier.example', tech: 'Laravel' },
  { domain: 'bergblick.example', tech: 'HubSpot' },
  { domain: 'druckerei.example', tech: 'TYPO3' },
];
const pool = [
  'alpha.example', 'nordlicht.example', 'kaffeehaus.example', 'werkstatt.example', 'atelier.example', 'bergblick.example',
  'kanzlei-mx.example', 'druckerei.example', 'gartenbau.example', 'fahrschule.example', 'buecherei.example', 'tierarzt.example',
];
const techs = ['TYPO3', 'WordPress', 'Contao', 'Laravel', 'HubSpot', 'WoltLab', 'kein CMS'];
const badgeW = current.tech.length * 8 + 28;
---
<svg class="margin-art scan" viewBox="0 0 140 700" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false" data-pool={JSON.stringify(pool)} data-techs={JSON.stringify(techs)} data-start="137">
  <text class="count" x="6" y="22">137 / 500</text>
  <text class="domain" x="6" y="62">{current.domain}</text>

  {signals.map((label, i) => (
    <g class={`sig done${hits[i] ? ' hit' : ''}`} transform={`translate(0 ${108 + i * 32})`}>
      <text x="6" y="0">{label}</text>
      <rect class="track" x="62" y="-5" width="52" height="4" rx="2" />
      <rect class="fill" x="62" y="-5" width="52" height="4" rx="2" />
      <path class="check" d="M120 -4 L123.5 -0.5 L130 -8" />
      <path class="dash" d="M121 -4 H129" />
    </g>
  ))}

  <g class="badge show" transform="translate(70 262)">
    <rect x={-badgeW / 2} y="-16" width={badgeW} height="32" rx="16" />
    <text x="0" y="5" text-anchor="middle">{current.tech}</text>
  </g>

  <line class="divider" x1="6" y1="326" x2="134" y2="326" />
  {history.map((h, i) => (
    <g class="hist" transform={`translate(0 ${364 + i * 54})`}>
      <text class="hd" x="6" y="0">{h.domain}</text>
      <text class="ht" x="6" y="18">{h.tech}</text>
    </g>
  ))}
</svg>

<script>
  const svg = document.querySelector<SVGSVGElement>('.scan');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (svg && !reduce.matches) {
    const pool: string[] = JSON.parse(svg.dataset.pool!);
    const techs: string[] = JSON.parse(svg.dataset.techs!);
    const domainEl = svg.querySelector<SVGTextElement>('.domain')!;
    const countEl = svg.querySelector<SVGTextElement>('.count')!;
    const sigs = [...svg.querySelectorAll<SVGGElement>('.sig')];
    const badge = svg.querySelector<SVGGElement>('.badge')!;
    const badgeText = badge.querySelector('text')!;
    const badgeRect = badge.querySelector('rect')!;
    const hist = [...svg.querySelectorAll<SVGGElement>('.hist')];
    let count = Number(svg.dataset.start);
    let n = 0;
    const timers: number[] = [];
    let alive = true;
    const wait = (ms: number) =>
      new Promise<void>((res) => timers.push(window.setTimeout(res, ms)));
    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    const histEntries = hist.map((h) => ({
      domain: h.querySelector('.hd')!.textContent!,
      tech: h.querySelector('.ht')!.textContent!,
    }));
    const renderHist = (newest: number) =>
      hist.forEach((h, i) => {
        h.querySelector('.hd')!.textContent = histEntries[i].domain;
        h.querySelector('.ht')!.textContent = histEntries[i].tech;
        h.classList.toggle('new', i === newest);
      });

    const play = async () => {
      while (alive) {
        if (svg.getBoundingClientRect().width === 0) {
          await wait(1000);
          continue;
        }
        const domain = pool[n++ % pool.length];
        const tech = techs[Math.floor(Math.random() * techs.length)];
        const found = tech !== 'kein CMS';
        let hits = sigs.map(() => found && Math.random() < 0.55);
        if (found && !hits.some(Boolean)) hits[Math.floor(Math.random() * hits.length)] = true;

        // Zurücksetzen
        badge.classList.remove('show');
        sigs.forEach((s) => s.classList.remove('done', 'hit', 'scanning'));
        domainEl.textContent = '';
        await wait(300);

        // Domain eintippen
        for (const ch of domain) {
          domainEl.textContent += ch;
          await wait(rand(35, 70));
        }

        // Signale nacheinander prüfen
        for (let i = 0; i < sigs.length; i++) {
          await wait(rand(120, 220));
          sigs[i].classList.add('scanning');
          await wait(rand(320, 520));
          sigs[i].classList.remove('scanning');
          sigs[i].classList.add('done');
          sigs[i].classList.toggle('hit', hits[i]);
        }

        // Ergebnis
        await wait(250);
        badgeText.textContent = tech;
        badgeRect.setAttribute('width', String(badgeText.getComputedTextLength() + 28));
        badgeRect.setAttribute('x', String(-(badgeText.getComputedTextLength() + 28) / 2));
        badge.classList.add('show');
        count += 1;
        countEl.textContent = `${count} / 500`;
        await wait(1100);

        // In die Ergebnisliste übernehmen: alles rückt eine Zeile nach oben
        histEntries.shift();
        histEntries.push({ domain, tech });
        renderHist(histEntries.length - 1);
        await wait(1400);
      }
    };
    play();
    reduce.addEventListener('change', () => {
      if (reduce.matches) {
        alive = false;
        timers.forEach(clearTimeout);
        sigs.forEach((s) => s.classList.add('done'));
        badge.classList.add('show');
      }
    });
  }
</script>
