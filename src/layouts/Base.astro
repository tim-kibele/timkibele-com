---
import '../styles/global.css';
import { t, other, type Lang } from '../i18n/ui';

interface Props { lang: Lang; title?: string; description?: string; path: string }
const { lang, title, description, path } = Astro.props;
const tr = t(lang);
const pageTitle = title ? `${title} · ${tr.siteTitle}` : tr.siteTitle;
const desc = description ?? tr.tagline;
const site = Astro.site!.origin;
const href = (p: string) => `/${lang}/${p}`;
// Der Name links führt auf die Startseite, deshalb gibt es keinen eigenen Menüpunkt "Start".
const nav = [
  ['projekte/', tr.nav.projects],
  ['interessen/', tr.nav.interests],
  ['lebenslauf/', tr.nav.cv],
  ['geheimnisse/', tr.nav.achievements],
] as const;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <script is:inline>try { var th = localStorage.getItem('theme'); if (th) document.documentElement.dataset.theme = th; } catch (e) {}</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    {import.meta.env.PROD && (
      <script is:inline type="module" src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "890885968c18448382c112be9895bcdf"}'></script>
    )}
    <link rel="canonical" href={`${site}/${lang}/${path}`} />
    <link rel="alternate" hreflang="de" href={`${site}/de/${path}`} />
    <link rel="alternate" hreflang="en" href={`${site}/en/${path}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={tr.siteTitle} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={`${site}/${lang}/${path}`} />
    <meta property="og:locale" content={lang === 'de' ? 'de_DE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'de' ? 'en_US' : 'de_DE'} />
    <meta property="og:image" content={`${site}/og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={tr.home.portraitAlt} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site">
      <div class="bar">
        <a class="brand" href={href('')} aria-current={Astro.url.pathname === href('') ? 'page' : undefined}>{tr.siteTitle}</a>
        <nav id="site-nav">
          {nav.map(([p, label]) => (
            <a href={href(p)} aria-current={Astro.url.pathname === href(p) ? 'page' : undefined}>{label}</a>
          ))}
        </nav>
        <div class="tools">
          <a class="lang-toggle" href={`/${other(lang)}/${path}`} hreflang={other(lang)} lang={other(lang)} aria-label={tr.switchTo} title={tr.switchTo}>{other(lang).toUpperCase()}</a>
          <button type="button" class="theme-toggle" data-dark={tr.theme.dark} data-light={tr.theme.light} hidden>
            <svg class="icon-moon" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" /></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6" /></svg>
          </button>
        </div>
        <button type="button" class="menu-toggle" aria-controls="site-nav" aria-expanded="false" aria-label={tr.nav.menu} title={tr.nav.menu} hidden>
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <div class="bar">
        © {new Date().getFullYear()} Tim Kibele · <a href={href('impressum/')}>{tr.nav.imprint}</a> · <a href={href('datenschutz/')}>{tr.nav.legal}</a>
      </div>
    </footer>
    <script is:inline>
      (function () {
        var m = document.querySelector('.menu-toggle'), n = document.getElementById('site-nav');
        if (m && n) {
          document.documentElement.classList.add('menu-js');
          m.hidden = false;
          function set(open) { n.classList.toggle('open', open); m.setAttribute('aria-expanded', open ? 'true' : 'false'); }
          m.addEventListener('click', function () { set(!n.classList.contains('open')); });
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && n.classList.contains('open')) { set(false); m.focus(); } });
        }
      })();
      (function () {
        var b = document.querySelector('.theme-toggle'), r = document.documentElement;
        var mq = matchMedia('(prefers-color-scheme: dark)');
        function cur() { return r.dataset.theme || (mq.matches ? 'dark' : 'light'); }
        function label() { var d = cur() === 'dark'; b.dataset.mode = d ? 'dark' : 'light'; b.setAttribute('aria-label', d ? b.dataset.light : b.dataset.dark); b.title = b.getAttribute('aria-label'); }
        b.hidden = false; label();
        b.addEventListener('click', function () {
          var n = cur() === 'dark' ? 'light' : 'dark';
          r.dataset.theme = n;
          try { localStorage.setItem('theme', n); } catch (e) {}
          label();
        });
        mq.addEventListener('change', label);
      })();
    </script>
  </body>
</html>
