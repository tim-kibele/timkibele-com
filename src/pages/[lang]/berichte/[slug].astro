---
import { getCollection, render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { t, dateFmt, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const reports = await getCollection('reports');
  return reports.map((entry) => {
    const [lang, slug] = entry.id.split('/');
    return { params: { lang, slug }, props: { entry } };
  });
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug!;
const { entry } = Astro.props;
const { Content } = await render(entry);
const tr = t(lang);
---
<Base lang={lang} title={entry.data.title} description={entry.data.description} path={`berichte/${slug}/`}>
  <p><a href={`/${lang}/berichte/`}>← {tr.back}</a></p>
  <h1>{entry.data.title}</h1>
  <p class="meta">{dateFmt(lang, entry.data.date)}</p>
  <div class="prose"><Content /></div>
</Base>
