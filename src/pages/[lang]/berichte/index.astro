---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { languages, t, dateFmt, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const reports = (await getCollection('reports'))
  .filter((r) => r.id.startsWith(`${lang}/`))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Base lang={lang} title={tr.reports.title} path="berichte/">
  <h1>{tr.reports.title}</h1>
  <p class="lead">{tr.reports.intro}</p>
  {reports.length === 0 && <p>{tr.reports.empty}</p>}
  <div class="grid">
    {reports.map((r) => (
      <article class="card">
        <h3><a href={`/${lang}/berichte/${r.id.split('/')[1]}/`}>{r.data.title}</a></h3>
        <p class="meta">{dateFmt(lang, r.data.date)}</p>
        <p>{r.data.description}</p>
      </article>
    ))}
  </div>
</Base>
