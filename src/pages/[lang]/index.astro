---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import portrait from '../../assets/portrait.jpg';
import Email from '../../components/Email.astro';
import { languages, t, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const rows = [
  { href: `/${lang}/projekte/`, name: tr.nav.projects, note: tr.projects.intro },
  { href: `/${lang}/interessen/`, name: tr.nav.interests, note: tr.interests.intro },
  { href: `/${lang}/lebenslauf/`, name: tr.nav.cv, note: tr.home.cvNote },
];
---
<Base lang={lang} path="">
  <div class="split split--portrait">
  <figure class="split-art portrait">
    <Image src={portrait} alt={tr.home.portraitAlt} width={1600} widths={[480, 800, 1100, 1600]} sizes="(min-width: 64rem) 45vw, 100vw" format="webp" quality={82} loading="eager" fetchpriority="high" />
  </figure>
  <div class="split-text">
  <section class="about">
    <h1>{tr.home.heading}</h1>
    <p class="lead">{tr.home.intro}</p>
    <div class="actions">
      <a class="btn btn--primary" href={`/${lang}/lebenslauf/`}>{tr.nav.cv}</a>
      <a class="btn" href={`/${lang}/projekte/`}>{tr.nav.projects}</a>
    </div>
  </section>

  <section class="more">
    <h2>{tr.home.more}</h2>
    <ul class="index">
      {rows.map((r) => (
        <li><a href={r.href}><span class="name">{r.name}</span><span class="note">{r.note}</span></a></li>
      ))}
    </ul>
  </section>

  <section class="closing">
    <h2>{tr.home.closing}</h2>
    <p><Email /></p>
  </section>
  </div>
  </div>
</Base>
