---
import Base from '../../../layouts/Base.astro';
import Email from '../../../components/Email.astro';
import { languages, t, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
---
<Base lang={lang} title={tr.legal.title} path="datenschutz/" description={lang === 'de' ? 'Datenschutzerklärung von Tim Kibele.' : 'Privacy policy of Tim Kibele.'}>
  <h1>{tr.legal.title}</h1>

  {lang === 'de' ? (
    <>
      <h2>Verantwortlicher</h2>
      <p>Verantwortlich im Sinne der DSGVO ist Tim Kibele, E-Mail: <Email /></p>

      <h2>Hosting bei GitHub Pages</h2>
      <p>Diese Website wird über GitHub Pages ausgeliefert, einen Dienst der GitHub, Inc. (USA), die zu Microsoft gehört. Beim Aufruf der Seite verarbeitet GitHub technisch notwendige Verbindungsdaten, insbesondere deine IP-Adresse, Datum und Uhrzeit, die aufgerufene Seite und Angaben zu deinem Browser. Ich selbst habe darauf keinen Zugriff und werte diese Daten nicht aus. Rechtsgrundlage ist Art. 6 Abs. 1 lit. f DSGVO (berechtigtes Interesse an einer sicheren und zuverlässigen Bereitstellung dieser Website). Dabei können Daten in die USA übermittelt werden. Näheres findest du in der <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">Datenschutzerklärung von GitHub</a>.</p>

      <h2>Lokaler Speicher</h2>
      <p>Die Seite merkt sich im lokalen Speicher deines Browsers, welche Easter Eggs du gefunden hast. Die Daten bleiben auf deinem Gerät und werden nicht übertragen. Du kannst sie auf der Erfolge-Seite zurücksetzen oder über die Einstellungen deines Browsers löschen.</p>

      <h2>Deine Rechte</h2>
      <p>Du hast das Recht auf Auskunft (Art. 15 DSGVO), Berichtigung (Art. 16), Löschung (Art. 17), Einschränkung der Verarbeitung (Art. 18), Datenübertragbarkeit (Art. 20) und Widerspruch (Art. 21). Wende dich dafür an die oben genannte E-Mail-Adresse.</p>
      <p>Außerdem kannst du dich bei einer Datenschutzaufsichtsbehörde beschweren. Für mich zuständig ist der Landesbeauftragte für den Datenschutz und die Informationsfreiheit Baden-Württemberg, Lautenschlagerstraße 20, 70173 Stuttgart.</p>
    </>
  ) : (
    <>
      <h2>Controller</h2>
      <p>The controller within the meaning of the GDPR is Tim Kibele, email: <Email /></p>

      <h2>Hosting on GitHub Pages</h2>
      <p>This website is served through GitHub Pages, a service of GitHub, Inc. (USA), which is part of Microsoft. When you visit the site, GitHub processes the connection data technically required to deliver it, in particular your IP address, date and time, the page requested and details about your browser. I have no access to this data and do not evaluate it. The legal basis is Art. 6(1)(f) GDPR (legitimate interest in providing this website securely and reliably). Data may be transferred to the USA. For details see <a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement" rel="noopener">GitHub's privacy statement</a>.</p>

      <h2>Local storage</h2>
      <p>The site remembers which Easter eggs you found in your browser's local storage. The data stays on your device and is not transmitted. You can reset it on the achievements page or delete it in your browser settings.</p>

      <h2>Your rights</h2>
      <p>You have the right of access (Art. 15 GDPR), rectification (Art. 16), erasure (Art. 17), restriction of processing (Art. 18), data portability (Art. 20) and objection (Art. 21). Contact me at the email address above.</p>
      <p>You can also lodge a complaint with a data protection authority. The authority responsible for me is the State Commissioner for Data Protection and Freedom of Information of Baden-Württemberg (Der Landesbeauftragte für den Datenschutz und die Informationsfreiheit Baden-Württemberg), Lautenschlagerstraße 20, 70173 Stuttgart, Germany.</p>
    </>
  )}
</Base>
