---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { languages, t, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const projects = (await getCollection('projects')).sort((a, b) => b.data.year - a.data.year);
---
<Base lang={lang} title={tr.projects.title} path="projekte/">
  <div class="split split--title">
  <div class="split-art"><h1>{tr.projects.title}</h1></div>
  <div class="split-text">
  <p class="lead">{tr.projects.intro}</p>
  <div class="grid">{projects.map((p) => <ProjectCard project={p} lang={lang} />)}</div>
  </div>
  </div>
</Base>
