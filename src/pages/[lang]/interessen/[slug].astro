---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import TypeRace from '../../../components/TypeRace.astro';
import ChessGame from '../../../components/ChessGame.astro';
import PianoTilesGame from '../../../components/PianoTilesGame.astro';
import { animations } from '../../../components/animations';
import { languages, t, type Lang } from '../../../i18n/ui';

export async function getStaticPaths() {
  const items = await getCollection('interests');
  return languages.flatMap((lang) => items.map((item) => ({ params: { lang, slug: item.id }, props: { item } })));
}
const lang = Astro.params.lang as Lang;
const slug = Astro.params.slug!;
const { item } = Astro.props;
const tr = t(lang);
const title = item.data.title[lang];
const Animation = item.data.animation ? animations[item.data.animation] : null;
// Blöcke im Textfeld, getrennt durch Leerzeilen: "## Titel" ist eine Überschrift, Zeilen mit "- " eine Liste,
// "::slot image Text" oder "::slot audio Text" ein Platzhalter für ein Bild oder einen Soundtest,
// "::race" das Tippduell, "::chess" die Schachpartie, "::boss" die versteckte zweite Partie (erscheint erst am Seitenende),
// "::tiles" das versteckte Kachelspiel der Musik-Seite.
const blocks = (item.data.text?.[lang] ?? tr.interests.note).split(/\n\s*\n/).map((b) => {
  if (b.startsWith('## ')) return { heading: b.slice(3) };
  if (b === '::race') return { race: true };
  if (b === '::chess') return { chess: true };
  if (b === '::boss') return { boss: true };
  if (b === '::tiles') return { tiles: true };
  const slot = b.match(/^::slot (image|audio) (.+)$/);
  if (slot) return { slot: slot[2], kind: slot[1] };
  const lines = b.split('\n');
  if (lines.every((l) => l.startsWith('- '))) return { list: lines.map((l) => l.slice(2)) };
  return { text: b };
});
const firstText = blocks.findIndex((b) => 'text' in b);
// Mit Animation steht sie auf der Bühne links, sonst der Seitentitel.
---
<Base lang={lang} title={title} description={tr.interests.intro} path={`interessen/${slug}/`}>
  <div class={Animation ? 'split' : 'split split--title'}>
  <div class="split-art">{Animation ? <Animation /> : <h1>{title}</h1>}</div>
  <div class="split-text">
  <p><a href={`/${lang}/interessen/`}>← {tr.back}</a></p>
  <section class="topic">
    {Animation && <h1>{title}</h1>}
    {blocks.map((b, i) =>
      'heading' in b ? <h2>{b.heading}</h2>
      : 'race' in b ? <TypeRace lang={lang} />
      : 'chess' in b ? <ChessGame lang={lang} />
      : 'boss' in b ? <ChessGame lang={lang} boss />
      : 'tiles' in b ? <PianoTilesGame lang={lang} />
      : 'slot' in b ? <div class={`slot slot--${b.kind}`}><span>{b.slot}</span></div>
      : 'list' in b ? <ul>{b.list.map((li) => <li>{li}</li>)}</ul>
      : <p class={i === firstText ? 'lead' : undefined}>{b.text}</p>
    )}
  </section>
  </div>
  </div>
</Base>
