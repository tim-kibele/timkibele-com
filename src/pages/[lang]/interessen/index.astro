---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { languages, t, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);
const items = (await getCollection('interests')).sort((a, b) => a.data.title[lang].localeCompare(b.data.title[lang], lang));
---
<Base lang={lang} title={tr.interests.title} description={tr.interests.intro} path="interessen/">
  <h1>{tr.interests.title}</h1>
  <p class="lead">{tr.interests.intro}</p>

  <ul class="index topics">
    {items.map((i) => (
      <li><a href={`/${lang}/interessen/${i.id}/`}><span class="name">{i.data.title[lang]}</span></a></li>
    ))}
  </ul>
</Base>
