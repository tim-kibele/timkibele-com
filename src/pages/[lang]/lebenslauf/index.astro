---
import Base from '../../../layouts/Base.astro';
import { languages, t, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);

type Row = { when?: string; title: string; org?: string; text?: string; tags?: string[] };
const cv = {
  de: {
    profile: 'Ich studiere Informatik an der LMU München und strebe einen Master in Informatik mit Spezialisierung auf KI an. Ich interessiere mich für alles rund um Technik, vor allem für KI, Gaming und mechanische Tastaturen.',
    headings: { experience: 'Berufserfahrung', education: 'Ausbildung', skills: 'Fähigkeiten', languages: 'Sprachen' },
    experience: [
      { when: '09/2026 – heute', title: 'Werkstudent', org: 'Onyva Innovation' },
      { when: '04/2026 – 09/2026', title: 'Tutor', org: 'LMU München', text: 'Tutorium zur Vorlesung „Logik und diskrete Strukturen“' },
    ] as Row[],
    education: [
      { when: '2024 – heute', title: 'Informatik mit integriertem Anwendungsfach Mathematik (B. Sc.)', org: 'LMU München' },
      { when: '2023 – 2024', title: 'Informatik (B. Sc.)', org: 'RWU Weingarten' },
    ] as Row[],
    skills: [
      { title: 'Programmiersprachen', tags: ['Python', 'Java', 'Haskell', 'JavaScript', 'SQL', 'C (Grundkenntnisse)'] },
      { title: 'Daten und KI', tags: ['pandas', 'NumPy', 'PyTorch', 'Matplotlib'] },
      { title: 'Datenbanken', tags: ['PostgreSQL'] },
      { title: 'Automation und Schnittstellen', tags: ['n8n', 'REST-APIs und JSON'] },
      { title: 'Werkzeuge', tags: ['Git und GitHub', 'Linux und Bash', 'Docker', 'Claude Code'] },
    ] as Row[],
    languages: [
      { title: 'Deutsch', text: 'Muttersprache' },
      { title: 'Englisch', text: 'C1' },
    ] as Row[],
  },
  en: {
    profile: 'I study computer science at LMU Munich and am aiming for a master’s degree in computer science with a specialisation in AI. I am interested in everything to do with technology, above all AI, gaming and mechanical keyboards.',
    headings: { experience: 'Experience', education: 'Education', skills: 'Skills', languages: 'Languages' },
    experience: [
      { when: '09/2026 – present', title: 'Working student', org: 'Onyva Innovation' },
      { when: '04/2026 – 09/2026', title: 'Tutor', org: 'LMU Munich', text: 'Tutorial for the lecture “Logic and Discrete Structures”' },
    ] as Row[],
    education: [
      { when: '2024 – present', title: 'Computer Science with Mathematics as the integrated minor (B.Sc.)', org: 'LMU Munich' },
      { when: '2023 – 2024', title: 'Computer Science (B.Sc.)', org: 'RWU Weingarten' },
    ] as Row[],
    skills: [
      { title: 'Programming languages', tags: ['Python', 'Java', 'Haskell', 'JavaScript', 'SQL', 'C (basics)'] },
      { title: 'Data and AI', tags: ['pandas', 'NumPy', 'PyTorch', 'Matplotlib'] },
      { title: 'Databases', tags: ['PostgreSQL'] },
      { title: 'Automation and interfaces', tags: ['n8n', 'REST APIs and JSON'] },
      { title: 'Tools', tags: ['Git and GitHub', 'Linux and Bash', 'Docker', 'Claude Code'] },
    ] as Row[],
    languages: [
      { title: 'German', text: 'Native' },
      { title: 'English', text: 'C1' },
    ] as Row[],
  },
}[lang];
const sections = [
  [cv.headings.experience, cv.experience],
  [cv.headings.education, cv.education],
  [cv.headings.skills, cv.skills],
  [cv.headings.languages, cv.languages],
] as const;
---
<Base lang={lang} title={tr.cv.title} description={cv.profile} path="lebenslauf/">
  <h1>{tr.cv.title}</h1>
  <p class="lead">{cv.profile}</p>

  <div class="cv">
    {sections.map(([heading, rows]) => (
      <section>
        <h2>{heading}</h2>
        <ul class="cv-rows">
          {rows.map((r) => (
            <li class="cv-row">
              <span class="when">{r.when ?? (r.tags ? r.title : '')}</span>
              <div>
                {!r.tags && <h3>{r.title}</h3>}
                {r.org && <p class="org">{r.org}</p>}
                {r.text && <p class="org">{r.text}</p>}
                {r.tags && <ul class="tags">{r.tags.map((tag) => <li>{tag}</li>)}</ul>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
