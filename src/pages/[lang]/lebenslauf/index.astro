---
import Base from '../../../layouts/Base.astro';
import { languages, t, type Lang } from '../../../i18n/ui';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
const tr = t(lang);

type Row = { when?: string; title: string; org?: string; text?: string; tags?: string[] };
const cv = {
  de: {
    profile: 'Ich studiere Informatik an der LMU München und strebe einen Master in Informatik mit Spezialisierung auf KI an. Ich interessiere mich für alles rund um Technik, vor allem für KI, Gaming und mechanische Tastaturen.',
    headings: { experience: 'Berufserfahrung', education: 'Ausbildung', skills: 'Fähigkeiten', languages: 'Sprachen' },
    experience: [
      { when: '09/2026 – heute', title: 'Werkstudent', org: 'Onyva Innovation' },
      { when: '04/2026 – 09/2026', title: 'Tutor', org: 'LMU München', text: 'Tutorium zur Vorlesung „Logik und diskrete Strukturen“' },
    ] as Row[],
    education: [
      { when: '2024 – heute', title: 'Informatik mit integriertem Anwendungsfach Mathematik (B. Sc.)', org: 'LMU München' },
      { when: '2023 – 2024', title: 'Informatik (B. Sc.)', org: 'RWU Weingarten' },
    ] as Row[],
    skills: [
      { title: 'Programmiersprachen', tags: ['Python', 'Java', 'Haskell', 'JavaScript', 'TypeScript', 'HTML und CSS', 'SQL', 'C (Grundkenntnisse)'] },
      { title: 'Daten und KI', tags: ['pandas', 'NumPy', 'PyTorch', 'Matplotlib'] },
      { title: 'Datenbanken', tags: ['PostgreSQL'] },
      { title: 'Automation und Schnittstellen', tags: ['n8n', 'REST-APIs und JSON'] },
      { title: 'Werkzeuge', tags: ['Git und GitHub', 'Linux und Bash', 'Docker', 'Caddy', 'Tailscale', 'Astro', 'pytest', 'Cloudflare (DNS)', 'Claude Code'] },
    ] as Row[],
    languages: [
      { title: 'Deutsch', text: 'Muttersprache' },
      { title: 'Englisch', text: 'C1' },
    ] as Row[],
  },
  en: {
    profile: 'I study computer science at LMU Munich and am aiming for a master’s degree in computer science with a specialisation in AI. I am interested in everything to do with technology, above all AI, gaming and mechanical keyboards.',
    headings: { experience: 'Experience', education: 'Education', skills: 'Skills', languages: 'Languages' },
    experience: [
      { when: '09/2026 – present', title: 'Working student', org: 'Onyva Innovation' },
      { when: '04/2026 – 09/2026', title: 'Tutor', org: 'LMU Munich', text: 'Tutorial for the lecture “Logic and Discrete Structures”' },
    ] as Row[],
    education: [
      { when: '2024 – present', title: 'Computer Science with Mathematics as the integrated minor (B.Sc.)', org: 'LMU Munich' },
      { when: '2023 – 2024', title: 'Computer Science (B.Sc.)', org: 'RWU Weingarten' },
    ] as Row[],
    skills: [
      { title: 'Programming languages', tags: ['Python', 'Java', 'Haskell', 'JavaScript', 'TypeScript', 'HTML and CSS', 'SQL', 'C (basics)'] },
      { title: 'Data and AI', tags: ['pandas', 'NumPy', 'PyTorch', 'Matplotlib'] },
      { title: 'Databases', tags: ['PostgreSQL'] },
      { title: 'Automation and interfaces', tags: ['n8n', 'REST APIs and JSON'] },
      { title: 'Tools', tags: ['Git and GitHub', 'Linux and Bash', 'Docker', 'Caddy', 'Tailscale', 'Astro', 'pytest', 'Cloudflare (DNS)', 'Claude Code'] },
    ] as Row[],
    languages: [
      { title: 'German', text: 'Native' },
      { title: 'English', text: 'C1' },
    ] as Row[],
  },
}[lang];
const sections = [
  [cv.headings.experience, cv.experience],
  [cv.headings.education, cv.education],
  [cv.headings.skills, cv.skills],
  [cv.headings.languages, cv.languages],
] as const;
---
<Base lang={lang} title={tr.cv.title} description={cv.profile} path="lebenslauf/">
  <p class="print-name">Tim Kibele · www.timkibele.com</p>
  <h1>{tr.cv.title}</h1>
  <p class="lead">{cv.profile}</p>
  <p class="cv-actions"><a class="btn" href={`/${tr.cv.pdfFile}`} download>{tr.cv.pdf}</a></p>

  <div class="cv">
    {sections.map(([heading, rows]) => (
      <section>
        <h2>{heading}</h2>
        <ul class="cv-rows">
          {rows.map((r) => (
            <li class="cv-row">
              <span class="when">{r.when ?? (r.tags ? r.title : '')}</span>
              <div>
                {!r.tags && <h3>{r.title}</h3>}
                {r.org && <p class="org">{r.org}</p>}
                {r.text && <p class="org">{r.text}</p>}
                {r.tags && <ul class="tags">{r.tags.map((tag) => <li data-egg={tag.startsWith('Git') ? 'git' : undefined}>{tag}</li>)}</ul>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>

<script>
  import { unlock } from '../../../scripts/achievements';

  // Easter Egg: Ein Klick auf "Git und GitHub" zeigt Berufserfahrung und Ausbildung als `git log`.
  // Die Einträge werden aus der Seite gelesen, es kommt nichts Neues dazu. Der Hash ist reine Dekoration
  // (aus dem Text berechnet, damit er stabil bleibt).
  const chip = document.querySelector<HTMLElement>('[data-egg="git"]');
  const cv = document.querySelector<HTMLElement>('.cv');
  if (chip && cv) {
    const sections = [...cv.querySelectorAll('section')].slice(0, 2);
    type Entry = { when: string; title: string; org: string; note: string; start: number };
    const startOf = (when: string) => {
      const m = when.match(/^(?:(\d{2})\/)?(\d{4})/);
      return m ? Number(m[2]) * 12 + Number(m[1] ?? 1) : 0;
    };
    const entries: Entry[] = sections
      .flatMap((s) => [...s.querySelectorAll('.cv-row')])
      .map((row) => {
        const when = row.querySelector('.when')?.textContent?.trim() ?? '';
        const orgs = row.querySelectorAll('.org');
        return {
          when,
          title: row.querySelector('h3')?.textContent?.trim() ?? '',
          org: orgs[0]?.textContent?.trim() ?? '',
          note: orgs[1]?.textContent?.trim() ?? '',
          start: startOf(when),
        };
      })
      .sort((a, b) => b.start - a.start);
    const hash = (s: string) => {
      let h = 5381;
      for (const c of s) h = (h * 33 + c.charCodeAt(0)) >>> 0;
      return h.toString(16).padStart(8, '0').slice(0, 7);
    };
    const line = (cls: string, text: string) => {
      const p = document.createElement('p');
      if (cls) p.className = cls;
      p.textContent = text;
      return p;
    };

    const log = document.createElement('section');
    log.className = 'gitlog';
    log.hidden = true;
    log.setAttribute('aria-label', 'git log');
    log.append(line('gitlog-cmd', '$ git log'));
    entries.forEach((e, i) => {
      const block = document.createElement('div');
      block.className = 'gitlog-commit';
      block.append(
        line('hash', `commit ${hash(e.when + e.title)}${i === 0 ? ' (HEAD -> main)' : ''}`),
        line('', 'Author: Tim Kibele'),
        line('', `Date:   ${e.when}`),
        line('msg', [e.title, e.org].filter(Boolean).join(', ')),
      );
      if (e.note) block.append(line('msg', e.note));
      log.append(block);
    });
    const exit = document.createElement('button');
    exit.type = 'button';
    exit.className = 'gitlog-exit';
    exit.textContent = '$ exit';
    log.append(exit);
    cv.after(log);

    const show = (on: boolean) => {
      log.hidden = !on;
      cv.hidden = on;
    };
    chip.addEventListener('click', () => {
      show(true);
      unlock('git-log');
      log.scrollIntoView({ block: 'nearest' });
    });
    exit.addEventListener('click', () => show(false));
    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !log.hidden) show(false);
    });
  }
</script>
